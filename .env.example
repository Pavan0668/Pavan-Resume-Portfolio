# SMTP Configuration for JKC Solutions Website
# -----------------------------------------------------------------
# Copy this file to `.env.local` for local development and fill in
# your actual credentials. NEVER commit `.env.local` to the repository.
#
# For production (e.g., Vercel), add these as Environment Variables
# in the Vercel project settings (Settings -> Environment Variables).
# -----------------------------------------------------------------

# SMTP server host (e.g., smtp.gmail.com, smtp.office365.com, etc.)
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# The email account used to send emails (must be allowed for SMTP)
SMTP_USER=your-email@gmail.com

# The app-specific password / SMTP password for the sending account
# For Gmail: Create an app password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password

# The email address that receives notifications (admin/company inbox)
MAIL_TO=admin@example.com